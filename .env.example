# Copy to .env (never commit .env). All values are optional; the app runs without any of them.
ARP_DATA_DIR=./data
ARP_SECRET_KEY=change-me-long-random-string

# Amazon Selling Partner API (only works with YOUR seller account and a private app you register)
SPAPI_LWA_CLIENT_ID=
SPAPI_LWA_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=

# Keepa (paid). Leave empty to keep the provider disabled.
KEEPA_API_KEY=

# ---- Supabase Edge Function secrets (set with `supabase secrets set NAME=value`; NEVER put these in web/, GitHub, or logs)
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected into functions by Supabase itself.
ALLOWED_ORIGINS=https://YOUR-GITHUB-NAME.github.io
ALLOWED_EMAILS=you@example.com
MAX_CALLS_PER_HOUR=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Helium 10 API token: Helium 10 -> Settings -> MCP -> Create API Key (needs a plan that includes MCP)
H10_MCP_TOKEN=
